{
  "permissions": {
    "ask": [
      "Bash(rm:*)",
      "Bash(git rm:*)",
      "Bash(mv:*)",
      "Bash(git mv:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/antes-do-pr.sh\"",
            "timeout": 400
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/exigir-pr.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
