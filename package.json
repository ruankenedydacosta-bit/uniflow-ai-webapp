{
  "name": "uniflow-ai-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-legal.mjs",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.js\" \"scripts/**/*.test.js\"",
    "test:uni-engine": "find src/features/uni-engine -name '*.test.js' -print0 | sort -z | xargs -0 node --test",
    "uni:eval": "node scripts/uni-eval/avaliar-regras-atuais.js",
    "uni:eval:modelo": "node --env-file-if-exists=.env.eval.local scripts/uni-eval/avaliar-modelo.js",
    "supabase:test-rls": "node scripts/supabase/test-rls.js",
    "supabase:test-memory-rls": "node scripts/supabase/test-memory-rls.js",
    "supabase:test-atomic-financial-action": "node scripts/supabase/test-atomic-financial-action.js",
    "product-knowledge:validate": "node scripts/product-knowledge/validate.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sentry/browser": "^10.69.0",
    "@supabase/supabase-js": "^2.110.2",
    "exceljs": "^4.4.0",
    "ogl": "^1.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "react-test-renderer": "^19.2.7",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
