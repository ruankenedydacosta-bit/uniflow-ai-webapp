VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_UNI_PREMIUM_VOICE_DEMO_ENABLED=false
VITE_UNI_LLM_ENABLED=false
# AUTH4: URL publica do app em producao, usada para montar o redirect do
# login com Google (signInWithOAuth). Sem barra final. Se vazio, cai no
# fallback window.location.origin em runtime, ou localhost:5173 em teste.
VITE_APP_URL=
# MEMORY3: Memória Inteligente Persistente do Uni Engine (Fase 3, Shadow-only).
# Todos os padrões são seguros (off). appliedToDecision permanece sempre false.
# VITE_UNI_ENGINE_ENABLED=true
# VITE_UNI_ENGINE_MEMORY_ENABLED=false
# VITE_UNI_ENGINE_MEMORY_READ_ENABLED=false
# VITE_UNI_ENGINE_MEMORY_WRITE_ENABLED=false
# VITE_UNI_ENGINE_MEMORY_SHADOW_MODE=true
# DECISION5: Camada de Decisão Cognitiva do Uni Engine (Fase 5, Shadow-only).
# Todas as flags nascem DESLIGADAS (nenhuma variável ausente ativa decisão).
# A camada apenas recomenda — appliedToDecision permanece sempre false.
# VITE_UNI_ENGINE_DECISION_ENABLED=false
# VITE_UNI_ENGINE_DECISION_SHADOW=false
# VITE_UNI_ENGINE_DECISION_TELEMETRY=false
# PLANNING6: Planning Engine do Uni Engine (Fase 6, Shadow-only).
# Todas as flags nascem desligadas e nenhum plano é executado.
# VITE_UNI_ENGINE_PLANNING_ENABLED=false
# VITE_UNI_ENGINE_PLANNING_SHADOW=false
# VITE_UNI_ENGINE_PLANNING_TELEMETRY=false
