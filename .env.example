VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_UNI_PREMIUM_VOICE_DEMO_ENABLED=false
# Conversa por voz em tempo real no assistente (OpenAI Realtime). Desligada,
# o assistente usa a captura antiga. A Edge Function uni-voice-realtime-session
# não filtra usuário: abre sessão quem tem assinatura ativa e minutos no ciclo.
VITE_UNI_REALTIME_VOICE_ENABLED=false
# AUTH4: URL publica do app em producao, usada para montar o redirect do
# login com Google (signInWithOAuth). Sem barra final. Se vazio, cai no
# fallback window.location.origin em runtime, ou localhost:5173 em teste.
VITE_APP_URL=
# OBSERVABILITY2: fundacao privacy-first e adapter Sentry. Todos os gates
# precisam estar explicitamente ligados; sem DSN valido o SDK nao inicializa.
# O DSN deve ser configurado no ambiente, nunca hardcoded no codigo.
VITE_UNIFLOW_TELEMETRY_ENABLED=false
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_APP_RELEASE=
VITE_APP_VERSION=
# Opcional no Vercel Preview para diferenciar o ambiente no contexto tecnico.
VITE_VERCEL_ENV=
# GA4 FASE 1: fundacao de pageviews manuais. Permanece desligada por padrao
# em qualquer ambiente. Mesmo habilitada, nao carrega o Google Tag nem envia
# dados antes de consentimento explicito fornecido pela futura camada de UI.
# Production usara o Measurement ID do Web Data Stream existente; Preview deve
# continuar com VITE_GA4_ENABLED=false ate configuracao separada/autorizada.
VITE_GA4_ENABLED=false
VITE_GA4_MEASUREMENT_ID=
# MEMORY3: Memória Inteligente Persistente do Uni Engine (Fase 3, Shadow-only).
# Todos os padrões são seguros (off). appliedToDecision permanece sempre false.
# VITE_UNI_ENGINE_ENABLED=true
# VITE_UNI_ENGINE_MEMORY_ENABLED=false
# VITE_UNI_ENGINE_MEMORY_READ_ENABLED=false
# VITE_UNI_ENGINE_MEMORY_WRITE_ENABLED=false
# VITE_UNI_ENGINE_MEMORY_SHADOW_MODE=true
# DECISION5: Camada de Decisão Cognitiva do Uni Engine (Fase 5, Shadow-only).
# Todas as flags nascem DESLIGADAS (nenhuma variável ausente ativa decisão).
# A camada apenas recomenda — appliedToDecision permanece sempre false.
# VITE_UNI_ENGINE_DECISION_ENABLED=false
# VITE_UNI_ENGINE_DECISION_SHADOW=false
# VITE_UNI_ENGINE_DECISION_TELEMETRY=false
# PLANNING6: Planning Engine do Uni Engine (Fase 6, Shadow-only).
# Todas as flags nascem desligadas e nenhum plano é executado.
# VITE_UNI_ENGINE_PLANNING_ENABLED=false
# VITE_UNI_ENGINE_PLANNING_SHADOW=false
# VITE_UNI_ENGINE_PLANNING_TELEMETRY=false
# GOALS7: Goal Engine do Uni Engine (Fase 7, Shadow-only).
# Identifica, estrutura, avalia e acompanha objetivos financeiros sem
# persistir, executar ou alterar respostas. Sombrear é seguro por padrão;
# a flag de ativação nasce desligada.
# VITE_UNI_ENGINE_GOALS_ENABLED=false
# VITE_UNI_ENGINE_GOALS_SHADOW=true
# VITE_UNI_ENGINE_GOALS_TELEMETRY=false
# REFLECTION8: Reflection & Learning Engine do Uni Engine (Fase 8, Shadow-only).
# Revisa interações, detecta correções e gera candidatos de aprendizado que
# NUNCA são aplicados (applied/persisted/changedBehavior permanecem false).
# Nenhuma variável ausente ativa reflexão ou candidatos em produção.
# VITE_UNI_ENGINE_REFLECTION_ENABLED=false
# VITE_UNI_ENGINE_REFLECTION_SHADOW=true
# VITE_UNI_ENGINE_REFLECTION_TELEMETRY=false
# VITE_UNI_ENGINE_LEARNING_CANDIDATES_ENABLED=false
# ACTIVATION9: Activation Engine do Uni Engine (Fase 9, ativação gradual).
# Decide, por capacidade, se partes seguras do resultado cognitivo podem
# influenciar o pipeline real. TUDO nasce desligado; produção não ativa por
# acidente; rollout percentual clampado entre 0 e 100; FULL_ROLLOUT e
# capacidades proibidas (MEMORY_WRITE/FINANCIAL_EXECUTION/LEARNING_APPLICATION/
# RESPONSE_CONTENT_INFLUENCE) permanecem bloqueados nesta fase.
# VITE_UNI_ENGINE_ACTIVATION_ENABLED=false
# VITE_UNI_ENGINE_ACTIVATION_SHADOW=true
# VITE_UNI_ENGINE_ACTIVATION_TELEMETRY=false
# VITE_UNI_ENGINE_ACTIVATION_ENVIRONMENTS=development
# VITE_UNI_ENGINE_ACTIVATION_TEST_USER_IDS=
# VITE_UNI_ENGINE_ACTIVATION_ROLLOUT_PERCENT=0
# VITE_UNI_ENGINE_CAP_METADATA_ONLY=false
# VITE_UNI_ENGINE_CAP_DIAGNOSTICS_ONLY=false
# VITE_UNI_ENGINE_CAP_QUESTION_GUIDANCE=false
# VITE_UNI_ENGINE_CAP_CLARIFICATION_GUIDANCE=false
# VITE_UNI_ENGINE_CAP_RESPONSE_STYLE_GUIDANCE=false
# VITE_UNI_ENGINE_CAP_RESPONSE_LENGTH_GUIDANCE=false
# VITE_UNI_ENGINE_CAP_CATEGORY_SUGGESTION=false
# VITE_UNI_ENGINE_CAP_ACCOUNT_SUGGESTION=false
# VITE_UNI_ENGINE_CAP_GOAL_SUGGESTION=false
# VITE_UNI_ENGINE_CAP_PLANNING_SUGGESTION=false
# VITE_UNI_ENGINE_CAP_RISK_WARNING=false
# VITE_UNI_ENGINE_CAP_CONFIDENCE_DISCLOSURE=false
# VITE_UNI_ENGINE_CAP_MEMORY_READ_GUIDANCE=false
# VITE_UNI_ENGINE_CAP_EPISTEMIC_CAUTION=false
# VITE_UNI_ENGINE_CAP_DECISION_RECOMMENDATION=false
# PARTE 1 — INTEGRATION (integração segura e controlada ao pipeline real).
# Camada adaptadora isolada: orienta SOMENTE pergunta, esclarecimento, estilo
# e comprimento entre templates fechados — nunca executa, nunca substitui a
# resposta, nunca escreve memória. Exige motor + activation + capacidade
# habilitadas. TUDO nasce desligado; produção não ativa por acidente.
# VITE_UNI_ENGINE_INTEGRATION_ENABLED=false
# VITE_UNI_ENGINE_INTEGRATION_SHADOW=true
# VITE_UNI_ENGINE_INTEGRATION_TELEMETRY=false
# PARTE 5 — APPLICATION (primeira ativação controlada).
# Aplica RESPONSE_STYLE_GUIDANCE e RESPONSE_LENGTH_GUIDANCE (texto) em DEV,
# com Integration e Activation habilitadas e usuário autorizado. QUESTION_GUIDANCE
# (Bloco 2) e CLARIFICATION_GUIDANCE (Bloco 3) produzem APENAS decisões
# observacionais (questionDecision / clarificationDecision) — nunca texto de
# pergunta/esclarecimento; a Uni nunca gera automaticamente. Exige motor +
# activation + integration habilitadas. TUDO nasce desligado; produção não ativa
# por acidente; qualquer falha → fallback ao texto legado.
# VITE_UNI_ENGINE_APPLICATION_ENABLED=false
# VITE_UNI_ENGINE_APPLICATION_TELEMETRY=false
# Capacidade de pergunta (decisão observacional, ativada aqui pela Application):
# VITE_UNI_ENGINE_CAP_QUESTION_GUIDANCE=false
# Capacidade de esclarecimento (decisão observacional, ativada aqui pela Application):
# VITE_UNI_ENGINE_CAP_CLARIFICATION_GUIDANCE=false
# PARTE 6 — CONTROLLED QUESTION (perguntas seguras pelo pipeline legado).
# Interruptor MESTRE da parte: permite que o pipeline legado utilize as decisões
# questionDecision/clarificationDecision para selecionar UMA pergunta segura por
# turno, exclusivamente a partir de template FECHADO permitido, em DEV, com
# usuário autorizado. A Uni NUNCA escreve texto livre de pergunta; Pending Action
# e confirmação permanecem SOBERANOS no legado. Exige motor + activation +
# integration + application habilitadas. TUDO nasce desligado.
# VITE_UNI_ENGINE_CONTROLLED_QUESTIONS_ENABLED=false
# PARTE 8 — CONVERSATION ROUTING (roteamento conversacional controlado em DEV).
# Permite que o pipeline legado consulte o Conversation Planner do MESMO turno
# para selecionar, de forma controlada, qual caminho conversacional JÁ autorizado
# deve prevalecer (ANSWER/QUESTION/CLARIFICATION/CONFIRMATION/WAIT/NONE). O
# roteamento NUNCA cria texto, NUNCA executa, NUNCA escreve memória e NUNCA
# substitui a máquina de estados legada (Pending Action). Confirmação obrigatória
# do legado tem precedência máxima; qualquer falha → rota legada integral. Exige
# motor + activation + integration + application habilitadas. TUDO nasce desligado.
# VITE_UNI_ENGINE_CONVERSATION_ROUTING_ENABLED=false
#
# PARTE 9 — COGNITIVE ORCHESTRATOR (consolidação final do Uni Engine).
# Permite que o pipeline legado consolide todas as camadas já produzidas (Observation,
# Guidance, Decision, Capability Readiness, Execution Readiness, Application,
# Conversation Planner, Conversation Routing) em um único snapshot observacional.
# O orquestrador NUNCA reexecuta nenhuma camada, NUNCA toma decisões e NUNCA
# altera o pipeline legado — qualquer falha → snapshot vazio fail-safe (FALLBACK).
# Exige motor + activation + integration + application habilitadas. TUDO nasce desligado.
# VITE_UNI_ENGINE_COGNITIVE_ORCHESTRATOR_ENABLED=false
# FASE 20 — TOOL CALLING. Execução exige opt-in separado e identidade completa.
# VITE_UNI_ENGINE_TOOL_CALLING_ENABLED=false
# VITE_UNI_ENGINE_TOOL_CALLING_SHADOW=true
# VITE_UNI_ENGINE_TOOL_CALLING_TELEMETRY=false
# VITE_UNI_ENGINE_TOOL_CALLING_REQUIRED=false
# VITE_UNI_ENGINE_TOOL_CALLING_EXECUTION_ALLOWED=false
# Agenda existente no shell simplificado. Opt-in; ausente ou false preserva a navegação atual.
VITE_SIMPLIFIED_AGENDA_ENABLED=false
# B.2: habilitar somente depois de aplicar e validar a migration 030 no ambiente alvo.
VITE_AGENDA_IDEMPOTENCY_ENABLED=false
VITE_UNI_AGENDA_CONTEXTUAL_FOLLOWUP_ENABLED=false
VITE_SIMPLIFIED_SUPPORT_NAV_ENABLED=false
# Ligado por padrão (decisão de produto, não experimento) -- kill switch de
# emergência, só desliga com 'false' explícito. Deixe ausente/comentado.
# VITE_PWA_INSTALL_PROMPT_ENABLED=false
